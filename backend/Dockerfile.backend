# Dockerfile.backend
# FastAPI backend container (optional — can also run locally with uvicorn).

FROM python:3.12-slim

WORKDIR /app

COPY python_backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend source
COPY python_backend/ .
# Copy adjacent analysis modules expected by main.py
COPY static_analysis/ /static_analysis/
COPY ai_review/ /ai_review/
COPY authority_review/ /authority_review/

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

EXPOSE 3001

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "3001"]
