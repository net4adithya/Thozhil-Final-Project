# Baked into the admin app's JS bundle at `npm run build` time (Vite only exposes
# VITE_-prefixed vars, and only ones present when the build actually runs). Used by
# copyLink() in ExamEditor.vue to build candidate invite links.
#
# This is safe to commit — it's a public URL, not a secret. Committing it (instead of
# relying on a local, gitignored .env on the VPS) is what makes GitHub Actions' build
# step pick it up too — the CI runner has no access to files that only exist locally on
# the VPS, so a manually-created .env there has zero effect on what CI actually builds.
VITE_CANDIDATE_APP_URL=https://assessment.prahladsingh.in